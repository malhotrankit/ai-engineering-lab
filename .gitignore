# Virtual environment
.venv/

# Python cache
__pycache__/
.pytest_cache/
.ruff_cache/

# macOS junk
.DS_Store

# Temp files
temp_*.html
temp_*.pdf

# API keys and credentials - never commit
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
secrets.*

# ChromaDB & LlamaIndex runtime storage (auto-generated on first run)
chroma_db/
chroma_db_storage/
*.chroma
**/sample_data/chroma_db/
**/sample_data/llama_storage/

# Local scratch space
scratch/
